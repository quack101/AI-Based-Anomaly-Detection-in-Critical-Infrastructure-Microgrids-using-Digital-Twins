# ── Supabase Configuration ──
# Get these from: https://app.supabase.com → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key

# ── Dataset Path ──
# Relative or absolute path to the UCI power consumption CSV
CSV_PATH=data/processed_data.csv

# ── Twin Engine Settings ──
# Number of past readings for the exponential moving average baseline
EMA_WINDOW=30

# Residual threshold multiplier (flag anomaly if residual > threshold * std_dev)
ANOMALY_THRESHOLD=3.0

# ── WebSocket Settings ──
# Delay between frames in seconds (controls replay speed)
WS_FRAME_DELAY=1.0
